{
	"name": "@teez-sdk/teez-b2c-api",
	"version": "4.0.0",
	"description": "TypeScript SDK for Teez B2C API",
	"keywords": [
		"api",
		"b2c",
		"sdk",
		"teez",
		"typescript"
	],
	"homepage": "https://github.com/mulfyx/teez-sdk/tree/main/packages/teez-b2c-api#readme",
	"bugs": {
		"url": "https://github.com/mulfyx/teez-sdk/issues"
	},
	"license": "MIT",
	"author": "mulfyx",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mulfyx/teez-sdk.git",
		"directory": "packages/teez-b2c-api"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "npm run typecheck && tsdown",
		"format": "oxfmt --check \"./src/**/*.{ts,tsx}\" \"./tests/**/*.ts\" \"./scripts/**/*.ts\"",
		"format:fix": "oxfmt --write \"./src/**/*.{ts,tsx}\" \"./tests/**/*.ts\" \"./scripts/**/*.ts\"",
		"generate:types": "npm run generate:types:raw && npm run lint:fix",
		"generate:types:raw": "node --import=tsx ./scripts/generate-operation-types.ts",
		"lint": "npm run oxlint && npm run format",
		"lint:fix": "npm run oxlint:fix && npm run format:fix",
		"oxlint": "oxlint -c ../../.oxlintrc.json ./src ./tests ./scripts",
		"oxlint:fix": "oxlint -c ../../.oxlintrc.json --fix ./src ./tests ./scripts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "npm run typecheck:src && npm run typecheck:scripts && npm run typecheck:tools",
		"typecheck:src": "tsc -p tsconfig.json",
		"typecheck:scripts": "tsc -p scripts/tsconfig.json",
		"typecheck:tools": "tsc -p tsconfig.tools.json",
		"typecheck:test": "tsc -p tsconfig.test.json"
	},
	"dependencies": {
		"valibot": "^1.3.1"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^4.1.2",
		"tsdown": "^0.21.7",
		"tsx": "^4.21.0",
		"vitest": "^4.1.2"
	},
	"engines": {
		"node": ">=20.9.0"
	}
}
